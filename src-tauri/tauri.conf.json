{
  "$schema": "https://raw.githubusercontent.com/nicoverbruggen/tauri-v2-schemas/refs/heads/main/src/tauri.conf.schema.json",
  "productName": "WifiHuman",
  "version": "0.3.0",
  "identifier": "com.wifihuman.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run kill-port; npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "WiFi Human",
        "width": 900,
        "height": 700,
        "resizable": true,
        "visible": false,
        "decorations": true,
        "minWidth": 600,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
